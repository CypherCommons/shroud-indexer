{
  "name": "silent-pay-indexer",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:debug": "NODE_ENV=dev nest start --debug --watch",
    "start:e2e": "NODE_ENV=e2e nest start",
    "start:prod": "node dist/main",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write --loglevel=silent \"src/**/*.ts\"",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "types:check": "tsc --noemit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": " NODE_ENV=e2e node --trace-warnings node_modules/.bin/jest --runInBand --no-cache --forceExit --config jest-e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "axios": "^1.20.0",
    "currency.js": "^2.0.4",
    "js-yaml": "^4.3.2",
    "lmdb": "^3.5.3",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "secp256k1": "^5.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.13",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/secp256k1": "^4.0.6",
    "@types/supertest": "^2.0.11",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.1.6-rc.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dockerode": "^5.0.1",
    "ecpair": "^2.1.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.2",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^2.3.2",
    "run-script-webpack-plugin": "^0.2.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.4",
    "tiny-secp256k1": "^2.2.3",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "~5.9.3",
    "webpack": "^5.105.4",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "picomatch": "4.0.4",
    "js-yaml": "$js-yaml",
    "@angular-devkit/core": {
      "ajv": "8.18.0"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "bash -c 'npm run types:check'"
    ],
    "*.{ts,yaml,json}": [
      "prettier --write"
    ]
  }
}
